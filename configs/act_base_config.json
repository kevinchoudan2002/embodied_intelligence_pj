{
    "dataset": {
        "repo_id": "/remote-home/wukehao/datasets/calvin_task_ABC_D/splitA"
    },
    "policy": {
        "type": "act",
        "device": "cuda",
        "repo_id": "local/training",
        "push_to_hub": false,
        "chunk_size": 100,
        "dim_model": 512,
        "n_encoder_layers": 4,
        "n_decoder_layers": 6,
        "n_heads": 8,
        "dim_feedforward": 2048,
        "kl_weight": 50,
        "dropout": 0.1,
        "use_vae": true,
        "n_action_steps": 100
    },
    "batch_size": 8,
    "steps": 30000,
    "eval_freq": 5000,
    "eval": {
        "n_episodes": 10,
        "batch_size": 10
    },
    "output_dir": "./outputs",
    "job_name": "act_training",
    "wandb": {
        "enable": false
    },
    "optimizer": {
        "lr": 5e-5
    }
}