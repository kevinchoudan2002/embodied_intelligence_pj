{
    "dataset": {
        "repo_id": "/remote-home/wukehao/datasets/calvin_merge_ABC"
    },
    "policy": {
        "type": "act",
        "device": "cuda",
        "repo_id": "local/final_model",
        "push_to_hub": false,
        "n_encoder_layers": 4,
        "n_decoder_layers": 6,
        "n_heads": 8,
        "dim_feedforward": 2048,
        "dropout": 0.1,
        "use_vae": true,
        "use_amp": true,
        "kl_weight": 5,
        "chunk_size": 200,
        "n_action_steps": 200,
        "dim_model": 512
    },
    "batch_size": 40,
    "steps": 50000,
    "eval_freq": 10000,
    "eval": {
        "n_episodes": 20,
        "batch_size": 20
    },
    "log_freq": 200,
    "save_freq": 5000,
    "num_workers": 12,
    "wandb": {
        "enable": true,
        "project": "calvin_act_final_envA"
    },
    "optimizer": {
        "lr": 7e-5
    },
    "output_dir": "./results/final_model_envABC",
    "job_name": "final_envABC"
}